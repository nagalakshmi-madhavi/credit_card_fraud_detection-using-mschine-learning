      "source": [
        "### Evaluation Metrics\n",
        "Since fraud detection is imbalanced, accuracy alone is misleading. Use:\n",
        "* Precision → how many predicted frauds are truly fraud.\n",
        "* Recall → how many actual frauds you catch.\n",
        "* F1 Score : balance of precision & recall.\n",
        "* ROC‑AUC :overall discrimination ability."
      ],
      "metadata": {
        "id": "h1rxZ1kadwDd"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "from sklearn.metrics import classification_report, roc_auc_score\n",
        "# Helper function\n",
        "def evaluate_model(name, model, X_val, y_val, X_test, y_test, is_nn=False):\n",
        "    if is_nn:\n",
        "        y_val_prob = model.predict(X_val).ravel()\n",
        "        y_val_pred = (y_val_prob > 0.5).astype(int)\n",
        "        y_test_prob = model.predict(X_test).ravel()\n",
        "        y_test_pred = (y_test_prob > 0.5).astype(int)\n",
        "    else:\n",
        "        y_val_pred = model.predict(X_val)\n",
        "        y_val_prob = model.predict_proba(X_val)[:,1]\n",
        "        y_test_pred = model.predict(X_test)\n",
        "        y_test_prob = model.predict_proba(X_test)[:,1]\n",
        "    val_report = classification_report(y_val, y_val_pred, output_dict=True)\n",
        "    test_report = classification_report(y_test, y_test_pred, output_dict=True)\n",
        "    return [\n",
        "        name,\n",
        "        round(val_report[\"accuracy\"], 4),\n",
        "        round(val_report[\"weighted avg\"][\"f1-score\"], 4),\n",
        "        round(roc_auc_score(y_val, y_val_prob), 4),\n",
        "        round(test_report[\"accuracy\"], 4),\n",
        "        round(test_report[\"weighted avg\"][\"f1-score\"], 4),\n",
        "        round(roc_auc_score(y_test, y_test_prob), 4)\n",
        "    ]\n",
        "# results\n",
        "results = []\n",
        "results.append(evaluate_model(\"Logistic Regression\", log_reg, X_val, y_val, X_test, y_test))\n",
        "results.append(evaluate_model(\"Decision Tree\", dt_model, X_val, y_val, X_test, y_test))\n",
        "results.append(evaluate_model(\"Random Forest\", rf_model, X_val, y_val, X_test, y_test))\n",
        "results.append(evaluate_model(\"XGBoost\", xgb_model, X_val, y_val, X_test, y_test))\n",
        "results.append(evaluate_model(\"SVM\", svm_model, X_val, y_val, X_test, y_test))\n",
        "# DataFrame\n",
        "df = pd.DataFrame(results, columns=[\n",
        "    \"Model\", \"Val Accuracy\", \"Val F1\", \"Val ROC-AUC\",\n",
        "    \"Test Accuracy\", \"Test F1\", \"Test ROC-AUC\"\n",
        "])\n",
        "print(df.to_string(index=False))"
